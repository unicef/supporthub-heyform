{
  "name": "heyform",
  "homepage": "https://heyform.net",
  "author": "EarlyBird, Inc.",
  "license": "AGPL-3.0",
  "private": true,
  "engines": {
    "pnpm": ">=8",
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm build:shared && run-p dev:webapp dev:server",
    "dev:webapp": "pnpm --filter ./packages/webapp dev",
    "dev:server": "pnpm --filter ./packages/server dev",
    "build:server": "pnpm build:shared && pnpm --filter ./packages/server build",
    "build:webapp": "pnpm build:shared && pnpm --filter ./packages/webapp build",
    "format": "prettier --write \"packages/**/*.{js,ts,tsx,css}\"",
    "lint": "node scripts/run-oxlint.js packages",
    "postinstall": "node scripts/build-shared.js && simple-git-hooks",
    "build:shared": "pnpm --filter ./packages/utils build && pnpm --filter ./packages/shared-types-enums build && pnpm --filter ./packages/answer-utils build"
  },
  "simple-git-hooks": {
    "pre-commit": "if ! command -v node >/dev/null 2>&1; then for d in \"$HOME\"/.nvm/versions/node/*/bin; do [ -d \"$d\" ] && PATH=\"$d:$PATH\"; done; export PATH; fi; ./node_modules/.bin/lint-staged --concurrent false"
  },
  "lint-staged": {
    "*.{js,json}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --parser=typescript --write",
      "node scripts/run-oxlint.js packages --fix --ignore-pattern '*.d.ts'"
    ]
  },
  "dependencies": {
    "@trivago/prettier-plugin-sort-imports": "4.3.0",
    "lint-staged": "^15.5.1",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.6.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "simple-git-hooks": "^2.13.0"
  },
  "pnpm": {
    "neverBuiltDependencies": [],
    "overrides": {
      "apollo-upload-client": "17.0.0",
      "fs-capacitor": "6.2.0",
      "multer": "2.5.0",
      "express": "4.22.3",
      "dayjs": "^1.11.3",
      "i18next": "^21.9.1",
      "cross-fetch": "3.1.5",
      "ip": "2.0.1",
      "ws": "7.5.13",
      "got": "11.8.5",
      "react-i18next": "^11.18.6",
      "@babel/traverse": "^7.24.1",
      "node-fetch": "2.6.7",
      "lodash": "4.18.1",
      "qs": "^6.16.1",
      "busboy": "1.6.0",
      "fast-xml-parser": "5.11.2",
      "axios": "1.20.0",
      "minimist": "^1.2.6",
      "nanoid": "3.3.20",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "form-data@4": "4.0.6",
      "follow-redirects": "^1.16.2",
      "handlebars": "4.7.10",
      "jws@3": "3.2.3",
      "jws@4": "4.0.1",
      "proxy-addr": "2.0.8",
      "body-parser@1": "1.20.9",
      "path-to-regexp@0": "0.1.13",
      "picomatch@2": "2.3.2",
      "moment": "^2.31.0",
      "@protobufjs/utf8": "^1.1.2"
    }
  }
}
